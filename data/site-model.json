      "copyKeys": ["worldLabel", "worldTitle", "worldCopy", "worldCta"],
      "animations": [
        { "target": ".world-image img", "props": "yPercent -10 -> 10, scale 1.15", "scrub": 1, "trigger": ".world", "start": "top bottom", "end": "bottom top" }
      ],
      "states": []
    },
    {
      "index": 5,
      "order": 5,
      "id": "journal",
