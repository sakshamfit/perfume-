      "components": ["Brand", "Lines", "hero-scene", "hero-copy", "hero-caption", "hero-wordmark", "scroll-cue"],
      "media": ["hero"],
      "copyKeys": ["heroOne", "heroTwo", "heroCopy", "explore", "scroll", "eau"],
      "animations": [
        { "target": ".hero-photo", "props": "yPercent 15, scale 1.13", "scrub": 1.2, "trigger": ".hero", "start": "top top", "end": "bottom top" },
        { "target": ".hero-copy", "props": "y -110, opacity 0", "scrub": 0.6, "trigger": ".hero", "start": "15% top", "end": "85% top" },
        { "target": ".hero-wordmark", "props": "yPercent -28", "scrub": 0.8, "trigger": ".hero", "start": "top top", "end": "bottom top" },
        { "target": ".hero-scene", "props": "pointer parallax x/y", "scrub": null, "trigger": "pointermove", "start": null, "end": null }
      ],
      "states": ["mouse parallax", "scroll scrub"]
    },
    {
      "index": 1,
      "order": 1,
      "id": "notes",
      "name": "Statement + staggered scent cards",
      "anchors": ["#notes"],
      "components": ["section-index", "intro-copy", "statement", "statement-word", "scent-grid", "scent-card", "card-tag", "card-copy", "card-plus"],
      "media": ["notes"],
      "copyKeys": ["label", "statement", "storySmall", "notesLabel", "notesTitle", "noteTabs"],
      "animations": [
        { "target": ".statement-word", "props": "opacity 0.2 -> 1, stagger 0.12", "scrub": 0.6, "trigger": ".statement", "start": "top 82%", "end": "bottom 45%" },
        { "target": ".scent-card", "props": "y [150,260,170,240] -> 0", "scrub": 0.8, "trigger": ".scent-grid", "start": "top 95%", "end": "center 48%" }
      ],
      "states": ["card click -> sets note tab + scrolls to #composition"]
    },
    {
      "index": 2,
      "order": 2,
      "id": "collection",
      "name": "Signature product (pinned)",
      "anchors": ["#collection"],
      "components": ["signature-stage", "signature-ghost", "signature-label", "signature-product", "signature-bottle", "signature-info", "pill"],
      "media": ["bottle"],
      "copyKeys": ["signature", "bottleTitle", "bottleCopy", "discover", "scent", "eau", "size"],
      "animations": [
        { "target": ".signature-stage", "props": "pin, end +=1100, scrub 1 (min-width 800px only)", "scrub": 1, "trigger": ".signature", "start": "top top", "end": "+=1100" },
        { "target": ".signature-bottle", "props": "y 55->-25, rotation -8->5, scale .84->1.06", "scrub": 1, "trigger": ".signature", "start": "top top", "end": "+=1100" },
        { "target": ".signature-ghost", "props": "xPercent -7 -> 8", "scrub": 1, "trigger": ".signature", "start": "top top", "end": "+=1100" },
        { "target": ".signature-info", "props": "y 80 -> -35", "scrub": 1, "trigger": ".signature", "start": "top top", "end": "+=1100" }
      ],
      "states": ["add to bag", "open product modal"]
    },
    {
      "index": 3,
      "order": 3,
      "id": "composition",
      "name": "Interactive note composition (tabs)",
      "anchors": ["#composition"],
      "components": ["note-tabs", "note-description", "product-notes", "composition-image"],
      "media": ["notes"],
      "copyKeys": ["notesLabel", "peach", "jasmine", "wood"],
      "animations": [
        { "target": ".reveal-line", "props": "yPercent 110 -> 0, power3.out, once", "scrub": null, "trigger": "each line", "start": "top 95%", "end": null }
      ],
      "states": ["keyboard-operable tabs (Opening / Heart / Trail)"]
    },
    {
      "index": 4,
